{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/blog",
      "destination": "https://fantasysportsnetwork.app/blog",
      "permanent": true
    },
    {
      "source": "/blog/:slug",
      "destination": "https://fantasysportsnetwork.app/blog/:slug",
      "permanent": true
    },
    {
      "source": "/content/generated/blog/:path*",
      "destination": "https://fantasysportsnetwork.app/content/generated/blog/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/league-sync",
      "destination": "/api/league"
    },
    {
      "source": "/api/notifications-register",
      "destination": "/api/notifications?action=register"
    },
    {
      "source": "/api/notifications-selftest",
      "destination": "/api/notifications?action=selftest"
    },
    {
      "source": "/api/transaction-wire-dispatch",
      "destination": "/api/transaction-wire?action=dispatch"
    },
    {
      "source": "/api/auth/yahoo/callback",
      "destination": "/api/auth/yahoo?action=callback"
    },
    {
      "source": "/api/blog/articles/publish",
      "destination": "/api/blog/articles?action=publish"
    },
    {
      "source": "/api/blog/global",
      "destination": "/api/blog/articles?action=global"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "functions": {
    "api/cron/generate-articles.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/transaction-wire-dispatch",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/notifications-dispatch",
      "schedule": "0 16 * * *"
    }
  ]
}
