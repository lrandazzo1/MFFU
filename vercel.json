{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": ".",
  "redirects": [
    { "source": "/blog", "destination": "https://fantasysportsnetwork.app/blog", "permanent": true },
    { "source": "/blog/:slug", "destination": "https://fantasysportsnetwork.app/blog/:slug", "permanent": true },
    { "source": "/content/generated/blog/:path*", "destination": "https://fantasysportsnetwork.app/content/generated/blog/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/transaction-wire-dispatch",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/notifications-dispatch",
      "schedule": "0 16 * * *"
    }
  ]
}
