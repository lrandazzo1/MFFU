{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-blog.mjs",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/reader.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/transaction-wire-dispatch",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/notifications-dispatch",
      "schedule": "0 16 * * *"
    }
  ]
}
