node_modules/
# Ignore Vercel's local cache but keep the project link committed so every
# clone/CLI deploy targets the `mffu` app project (not `fsn-landing`).
.vercel/*
!.vercel/project.json
*.log
.DS_Store

# Capacitor generates the native project and staged payload on each build.
# Only ios/ templates and handoff docs are source-controlled.
ios/App/
www/
ios/App/App/public/
ios/App/Pods/
ios/App/build/
ios/App/App.xcworkspace/xcuserdata/
ios/App/App.xcodeproj/xcuserdata/
ios/App/App.xcodeproj/project.xcworkspace/xcuserdata/
DerivedData/
