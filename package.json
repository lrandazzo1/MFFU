{
  "name": "mffu",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:ios",
    "build:ios": "node scripts/build-ios.mjs",
    "ios:assets": "npm run assets:source && capacitor-assets generate --ios --assetPath assets && node scripts/check-ios-assets.mjs",
    "ios:sync": "npm run build:ios && npx cap sync ios && npm run ios:assets && npm run ios:minos && npm run ios:applinks && cd ios/App && pod install",
    "ios:minos": "node scripts/ios-min-os.mjs",
    "ios:applinks": "node scripts/ios-associated-domains.mjs",
    "ios:open": "npx cap open ios",
    "test:triggers": "node lib/notifications/selftest.js",
    "test:wire": "node --test lib/transaction-wire/selftest.js",
    "check:wire": "node scripts/transaction-wire-check.mjs",
    "check:scope": "node scripts/scope-scan.mjs",
    "check:matchup-previews": "node scripts/matchup-preview-guard-check.mjs",
    "check:render": "node scripts/render-check.mjs",
    "check:localdesk": "node scripts/local-desk-check.mjs",
    "check:switch": "node scripts/switch-curtain-check.mjs",
    "check:ticker": "node scripts/ticker-scope-check.mjs",
    "check:desktop-scroll": "node scripts/desktop-scroll-check.mjs",
    "check:desk-sync": "node scripts/desk-sync-check.mjs",
    "check:boot": "node scripts/boot-curtain-check.mjs",
    "check:invite": "node scripts/invite-flow-check.mjs",
    "check:apibase": "node scripts/api-base-check.mjs",
    "check:links": "node scripts/legal-links-check.mjs",
    "check:claims": "node scripts/landing-claims-check.mjs",
    "check:news": "node scripts/news-library-check.mjs",
    "check:articles": "node scripts/article-ingest-check.mjs",
    "check:applinks": "node scripts/check-applinks.mjs",
    "check:deeplinks": "node scripts/deeplink-check.mjs",
    "build:blog": "node scripts/build-blog.mjs",
    "check:blog": "node scripts/build-blog.mjs --check",
    "generate:editorial": "node scripts/generate-editorial.mjs",
    "check:editorial": "node scripts/generate-editorial.mjs --self-test",
    "verify": "npm run check:scope && npm run check:matchup-previews && npm run test:wire && npm run check:wire && npm run test:triggers && npm run audit:notifications && npm run check:render && npm run check:localdesk && npm run check:switch && npm run check:ticker && npm run check:desktop-scroll && npm run check:desk-sync && npm run check:boot && npm run check:invite && npm run check:apibase && npm run check:links && npm run check:claims && npm run check:news && npm run check:articles && npm run check:applinks && npm run check:deeplinks && npm run check:editorial",
    "audit:notifications": "node scripts/audit-notifications.mjs",
    "assets:source": "node scripts/build-brand-assets.mjs",
    "check:release": "npm run build:ios && node scripts/release-cleanup-check.mjs && node scripts/release-browser-check.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/core": "^6.1.2",
    "@capacitor/ios": "^6.1.2",
    "@capacitor/push-notifications": "^6.0.5",
    "@supabase/supabase-js": "^2.57.4",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.1.2",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "playwright": "^1.63.0",
    "sharp": "0.32.6",
    "typescript": "^5.9.3"
  }
}
